# QubitKey environment example — copy to .env and fill locally.
# Never commit real credentials.
#
# Live demo (reference only; configure secrets in Render / Vercel dashboards):
#   App: https://qubitkey.vercel.app
#   API: https://qubitkey-backend.onrender.com
# See docs/DEPLOYMENT.md

# CORS origins (comma-separated)
# Local:
QUBITKEY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example (Render):
# QUBITKEY_CORS_ORIGINS=https://qubitkey.vercel.app,https://qubitkey-kisom-projects.vercel.app,http://localhost:5173

# Frontend (Vercel / local Vite) — baked at build time for production
# VITE_API_BASE=https://qubitkey-backend.onrender.com
# Local default: leave unset and use the Vite /api proxy to localhost:8000

# Optional IBM Quantum credentials
# IBM_QUANTUM_TOKEN=
# IBM_QUANTUM_INSTANCE=
# IBM_QUANTUM_CHANNEL=ibm_quantum_platform
# IBM_QUANTUM_BACKEND=

# Feature flags
QUBITKEY_ENABLE_PQC=false
QUBITKEY_ENABLE_IBM_QPU=false
